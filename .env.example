# 复制为 .env 后修改。
# 首次启动使用的管理员密钥；留空则随机生成（见启动日志或数据目录 admin-key.txt）
LANDROP_ADMIN_KEY=change-me-to-a-strong-key
# 对外暴露的宿主机端口，默认 8000
LANDROP_PORT=8000
# 宿主机数据目录（状态库、文件、分块、回收站都在这里）
LANDROP_DATA_DIR=./data
# 对外访问地址（容器内看不到宿主机地址，务必设为局域网地址，否则分享链接不可用）
# 查询宿主机 IP： ip route get 1.1.1.1 | awk '{print $7}'
LANDROP_PUBLIC_URL=http://192.168.1.100:8800
# 容器运行身份（须与数据目录属主一致）。查询方式: id -u  /  id -g
PUID=1000
PGID=1000
# 时区
TZ=Asia/Shanghai
